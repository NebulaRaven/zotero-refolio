stylepersonal-AI-Generate-Tags = 
    .label = AI Generate Tags
    .tooltiptext = Select multiple entries (with abstracts), right-click > AI Generate Tags to automatically generate tags for each entry based on their abstracts.

stylepersonal-Prompt = Prompt

stylepersonal-AI-Generate-Remark = 
    .label = AI Generate Remark
    .tooltiptext = Select multiple entries (with abstracts), right-click > AI Generate Remark to automatically generate remarks for each entry based on their abstracts.

stylepersonal-Tab-Manager = 
    .label = Tab Manager
    .tooltiptext = When opening multiple PDFs, tabs may not fully display. This function provides a tab management panel similar to Chrome. Access it via the downward arrow on the far right of the tab bar.

stylepersonal-Tab-Manager-select-close-UI =
    .label = After selecting a tab, open and close Tab Manager interface.

stylepersonal-Tab-Manager-open-tabs-reverse-sort =
    .label = Reverse sort the open tabs

stylepersonal-Tab-Manager-width = Width


stylepersonal-Column-Cited-Counts = 
    .label = Cited Counts Column
    .tooltiptext = Displays the number of citations for a document, sourced from Semantics Scholar.

stylepersonal-SidePanel-Explore = 
    .label = Right SidePanel Explore Panel
    .tooltiptext = An alternative layout of the entry information panel with improved readability. Zotero’s original entry information panel is editable but lacks readability. The Explore Panel displays title, author, abstract, annotations, and notes (directly visible without expansion) in a reorganized format for better readability.
stylepersonal-Bibliography = 
    .label = Display Citation Text
    .tooltiptext = Displays citation text at the bottom of the Explore Panel. You can adjust CSL and copy the citation text directly, useful for creating slideshows. For Word, it’s recommended to use Zotero’s official plugin.
stylepersonal-Render-Item-Notes = 
    .label = Render Item Notes
    .tooltiptext = Displays all notes for an item in the Explore interface.

stylepersonal-Render-Item-Annotations = 
    .label = Render Item Annotations
    .tooltiptext = Displays all annotations for an item in the Explore interface.

stylepersonal-Attachment-Preview = 
    .label = Right SidePanel Attachment Preview
    .tooltiptext = Previews attachments (e.g., PDFs or web snapshots) directly in the sidebar.
stylepersonal-Backlinks = 
    .label = Annotation-Note Backlinks
    .tooltiptext = In the PDF reading panel, the top-right corner of an annotation can show how many notes in the Zotero library reference this annotation. Clicking it reveals which notes reference it and where.
stylepersonal-Note-Manager =
    .label = Note Manager Panel
    .tooltiptext = In the toolbar at the top of the items pane, click the "note" icon to display all notes for all items in the current collection.

stylepersonal-Annotation-Manager = 
    .label = Annotation Manager Panel and Paper Matrix
    .tooltiptext = In the toolbar at the top of the items pane, click the "A" icon to display all annotations for all items in the current collection. This panel can generate a literature matrix. See documentation for details.

stylepersonal-Ignore-figure-table-annotations = 
    .label = Ignore Figure/Table Annotations
    .tooltiptext = These annotations are generated by the PDF Figure plugin and usually come with labels like "Figure 1" or "Table 1."
stylepersonal-Replace-annotation-text-with-comment = 
    .label = Replace Annotation Text with Comment When Available
