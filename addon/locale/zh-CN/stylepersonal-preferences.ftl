stylepersonal-about-share =
    .value = 分享
stylepersonal-about-issue =
    .value = 反馈问题
stylepersonal-about-changelog =
    .value = 更新日志

stylepersonal-Vertical-Tab-Manager = 
    .label = 垂直标签页
    .tooltiptext = 在Zotero左侧显示垂直标签页，可以创建标签页组，方便查看管理多个打开的标签页。
